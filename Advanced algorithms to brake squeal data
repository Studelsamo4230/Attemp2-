from kmodes.kprototypes import KPrototypes

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from scipy.stats import f_oneway
from scipy.stats import chi2_contingency

from sklearn.metrics import silhouette_score
df = pd.read_csv(
    "dataset_brakesys_CAE_Dyno_sim_to_real_brakedata_pressure_5_to_30bar.csv"
)

print("Dataset preview:")
print(df.head())


# ============================================================
# 3. DATASET INFORMATION
# ============================================================

print("\nDataset shape:")
print(df.shape)

print("\nMissing values:")
print(df.isnull().sum())


# ==========================================
# 4. Drop ID / NON-RELEVANT columns
# ==========================================

df = df.drop(
    [
        "Test_ID",
        "Vehicle_Class",
        "Squeal_dB",
        "Squeal_Present"
    ],
    axis=1
)


# ==========================================
# 5. Separate Features
# ==========================================
#
# IMPORTANT:
#
# The three frequency/deviation variables are NOT used
# for clustering.
#
# They remain in df because we want to analyze them
# AFTER the clusters have been created.
# ==========================================

X = df.drop(
    [
        "CAE_Unstable_Frequency_Hz",
        "Dyno_Squeal_Frequency_Hz",
        "Frequency_Deviation_Hz"
    ],
    axis=1
)


# ==========================================
# 6. Define Categorical Features
# ==========================================

categorical_cols = X.select_dtypes(
    include=["object", "category"]
).columns.tolist()

for col in categorical_cols:
    X[col] = X[col].astype(str)

# ==========================================
# 7. Define Numerical Features
# ==========================================

numerical_cols = X.select_dtypes(
    include=[np.number]
).columns.tolist()


print("\nNumerical features:")
print(numerical_cols)

print("\nCategorical features:")
print(categorical_cols)

# ==========================================
# Scale Numerical Features Only
# ==========================================

scaler = StandardScaler()

X[numerical_cols] = scaler.fit_transform(
    X[numerical_cols]
)




# ==========================================
# 11. Find Categorical Column Indices
# ==========================================

categorical_indices = [
    X.columns.get_loc(col)
    for col in categorical_cols
]

print("\nCategorical column indices:")
print(categorical_indices)

from sklearn.decomposition import PCA
pca= PCA(n_components=12)
X_PCA= pca.fit_transform(X[numerical_cols])
print(pca.explained_variance_ratio_)

pc_columns = [
    f"PC{i+1}"
    for i in range(12)
]

X_pca_df = pd.DataFrame(
    X_PCA,
    columns=pc_columns,
    index=X.index
)


# Add categorical variables

X_pca_df[categorical_cols] = X[
    categorical_cols
].values


print("\n==========================================")
print("K-PROTOTYPES INPUT AFTER PCA")
print("==========================================")

display(X_pca_df.head())
print(X_pca_df.shape[1])

X_matrix = X_pca_df.to_numpy()

categorical_indices = [
    X_pca_df.columns.get_loc(col)
    for col in categorical_cols
]


print("\nCategorical column indices:")
print(categorical_indices)

# ==========================================
# 13. Mixed-Data Silhouette Analysis
# ==========================================
#
# K-Prototypes uses both:
#
# Numerical dissimilarity:
#       squared Euclidean distance
#
# Categorical dissimilarity:
#       number of mismatched categories
#
# Combined:
#
# d(i,j) =
# numerical distance
# +
# gamma * categorical distance
#
# We calculate the silhouette score using this
# K-Prototypes-compatible mixed-data distance.
# =========================================

# ------------------------------------------
# 13.1 Determine gamma
# ------------------------------------------
#
# gamma controls the relative contribution of
# categorical variables.
#
# We obtain gamma from K-Prototypes itself.
# ------------------------------------------

gamma_model = KPrototypes(
    n_clusters=3,
    init="Cao",
    n_init=10,
    max_iter=200,
    random_state=42,
    verbose=0
)

gamma_model.fit_predict(
    X_matrix,
    categorical=categorical_indices
)

gamma = gamma_model.gamma

print("\nK-Prototypes gamma:")
print(gamma)


# ------------------------------------------
# 13.2 Separate numerical and categorical
# data as numpy arrays
# ------------------------------------------

X_pca_numeric = X_pca_df[
    pc_columns
].to_numpy()

X_categorical = X_pca_df[
    categorical_cols
].to_numpy()


n_samples = len(X_pca_df)

distance_matrix = np.zeros(
    (n_samples, n_samples)
)


for i in range(n_samples):

    # Numerical squared Euclidean distance

    numerical_distance = np.sum(
        (
            X_pca_numeric[i]
            -
            X_pca_numeric
        ) ** 2,
        axis=1
    )


    # Categorical mismatch distance

    categorical_distance = np.sum(
        X_categorical[i]
        !=
        X_categorical,
        axis=1
    )


    # Combined K-Prototypes distance

    distance_matrix[i, :] = (
        numerical_distance
        +
        gamma * categorical_distance
    )


# ============================================================
# 18. SILHOUETTE ANALYSIS
# ============================================================

silhouette_scores = {}

best_score = -1

best_k = 2


print("\n==========================================")
print("MIXED-DATA SILHOUETTE ANALYSIS")
print("==========================================")


for k in range(2, 16):

    kproto = KPrototypes(
        n_clusters=k,
        init="Cao",
        n_init=20,
        max_iter=300,
        random_state=42,
        gamma=gamma,
        verbose=0
    )


    clusters_labels = kproto.fit_predict(
        X_matrix,
        categorical=categorical_indices
    )


    score = silhouette_score(
        distance_matrix,
        clusters_labels,
        metric="precomputed"
    )


    silhouette_scores[k] = score


    print(
        f"K = {k:2d} "
        f"→ Silhouette = {score:.4f}"
    )


    if score > best_score:

        best_score = score

        best_k = k


print("\n==========================================")
print("BEST K")
print("==========================================")

print(
    f"Best K = {best_k}"
)

print(
    f"Best Silhouette Score = "
    f"{best_score:.4f}"
)

# ==========================================
# 13.5 Plot Silhouette Scores
# ==========================================

plt.figure(figsize=(8, 5))

plt.plot(
    list(silhouette_scores.keys()),
    list(silhouette_scores.values()),
    marker="o"
)

plt.xlabel("Number of Clusters (K)")
plt.ylabel("Mixed-Data Silhouette Score")

plt.title(
    "K-Prototypes Cluster Selection "
    "Using Mixed-Data Silhouette Score"
)

plt.xticks(
    range(2, 16)
)

plt.grid(True)

plt.show()

best_k = 2

print(
    f"\nSelected number of clusters is K = {best_k}"
)


# ==========================================
# 16. Final K-Prototypes Model
# ==========================================

kproto = KPrototypes(
    n_clusters=best_k,
    init="Cao",
    n_init=20,
    max_iter=300,
    random_state=42,
    verbose=0
)

clusters = kproto.fit_predict(
    X_matrix,
    categorical=categorical_indices
)

# ==========================================
# 19. Numeric Analysis per Cluster
# ==========================================
df["Cluster"] = clusters
print("\n=== Numeric Analysis per Cluster ===")

print(
    df.groupby("Cluster")
      .mean(numeric_only=True)
      .round(3)
)


# ==========================================
# 20. Average Deviation per Cluster
# ==========================================

print("\n=== Average Deviation per Cluster ===")

print(
    df.groupby("Cluster")[
        "Frequency_Deviation_Hz"
    ]
    .mean()
    .round(2)
)

# ==========================================
# 22. Categorical Analysis (Counts)
# ==========================================

print("\n=== Categorical Distribution (Counts) ===")

for col in categorical_cols:

    print(f"\n--- {col} ---")

    print(
        df.groupby("Cluster")[col]
          .value_counts()
    )

print("\n=== Categorical Distribution (Percentages) ===")

for col in categorical_cols:

    print(f"\n--- {col} ---")

    print(
        df.groupby("Cluster")[col]
          .value_counts(normalize=True)
          .mul(100)
          .round(2)
    )


print("\n=== Crosstab Analysis ===")

for col in categorical_cols:

    print(f"\n--- {col} ---")

    table = pd.crosstab(
        df["Cluster"],
        df[col],
        normalize="index"
    ) * 100

    print(
        table.round(2)
    )

